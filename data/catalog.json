  "dialogues": {
    "border_start": [
      {
        "id": "border_001",
        "order": 1,
        "speaker": "",
        "portrait": "",
        "side": "LEFT",
        "text": "晨霧散去，隊伍在邊境集結。"
      },
      {
        "id": "border_002",
        "order": 2,
        "speaker": "艾爾",
        "portrait": "player_swordsman_01",
        "side": "LEFT",
        "text": "前方就是集結區。先確認彼此的位置，再一起推進。"
      },
      {
        "id": "border_003",
        "order": 3,
        "speaker": "琳恩",
        "portrait": "player_archer_01",
        "side": "LEFT",
        "text": "我會看住遠處。別讓敵人繞到我們背後。"
      },
      {
        "id": "border_004",
        "order": 4,
        "speaker": "帝國騎士",
        "portrait": "knight_enemy",
        "side": "RIGHT",
        "text": "守住陣線，不准他們通過！"
      }
    ],
    "border_turn": [
      {
        "id": "border_005",
        "order": 1,
        "speaker": "米菈",
        "portrait": "player_mage_01",
        "side": "LEFT",
        "text": "戰線已經展開。留意魔力，別把所有力量一次用盡。"
      }
    ],
    "border_area": [
      {
        "id": "border_006",
        "order": 1,
        "speaker": "雷昂",
        "portrait": "player_knight_01",
        "side": "LEFT",
        "text": "已經抵達中央。我來守住這裡，你們繼續前進。"
      }
    ],
    "border_win": [
      {
        "id": "border_007",
        "order": 1,
        "speaker": "艾爾",
        "portrait": "player_swordsman_01",
        "side": "LEFT",
        "text": "附近已經安全了。清點物資，確認所有人都回來。"
      }
    ],
    "border_loss": [
      {
        "id": "border_008",
        "order": 1,
        "speaker": "",
        "portrait": "",
        "side": "LEFT",
        "text": "隊伍失去了繼續戰鬥的能力。可以回溯回合，重新安排進攻。"
      }
    ],
    "chapter_intro": [
      {
        "id": "chapter_i01",
        "order": 1,
        "speaker": "",
        "portrait": "",
        "side": "LEFT",
        "text": "中央的寶箱仍留在戰場上，敵軍已經封住前路。"
      },
      {
        "id": "chapter_i02",
        "order": 2,
        "speaker": "艾爾",
        "portrait": "player_swordsman_01",
        "side": "LEFT",
        "text": "我們要取回寶箱裡的寶物，也要清除所有敵軍，才能安全撤離。"
      },
      {
        "id": "chapter_i03",
        "order": 3,
        "speaker": "琳恩",
        "portrait": "player_archer_01",
        "side": "LEFT",
        "text": "先決定出戰人員與陣形。我會留意敵方弓箭手。"
      }
    ],
    "chapter_chest": [
      {
        "id": "chapter_c01",
        "order": 1,
        "speaker": "",
        "portrait": "",
        "side": "LEFT",
        "text": "箱蓋緩緩打開。隊伍取得了「邊境徽章」。"
      },
      {
        "id": "chapter_c02",
        "order": 2,
        "speaker": "艾爾",
        "portrait": "player_swordsman_01",
        "side": "LEFT",
        "text": "寶物已經找到了。確認戰場安全後，再一起帶回去。"
      }
    ],
    "chapter_outro": [
      {
        "id": "chapter_o01",
        "order": 1,
        "speaker": "",
        "portrait": "",
        "side": "LEFT",
        "text": "戰利品與作戰經驗已完成清點，隊伍準備離開。"
      },
      {
        "id": "chapter_o02",
        "order": 2,
        "speaker": "艾爾",
        "portrait": "player_swordsman_01",
        "side": "LEFT",
        "text": "任務完成。大家辛苦了，回去休息吧。"
      },
      {
        "id": "chapter_o03",
        "order": 3,
        "speaker": "琳恩",
        "portrait": "player_archer_01",
        "side": "LEFT",
        "text": "全員準備撤離。下一次，也要一起回來。"
      }
    ],
    "common_defeat": [
      {
        "id": "common_d01",
        "order": 1,
        "speaker": "",
        "portrait": "",
        "side": "LEFT",
        "text": "這次作戰未能完成。隊伍已無法按照原計畫繼續前進。"
      },
      {
        "id": "common_d02",
        "order": 2,
        "speaker": "",
        "portrait": "",
        "side": "LEFT",
        "text": "可以退出關卡、回溯至先前回合，或重新整備再戰。"
      }
    ]
  },
